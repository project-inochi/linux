# common clock support for ESWIN SoC family.

config CLK_ESWIN_EIC7700
	tristate "Support for the ESWIN EIC7700 series SoCs clock controller"
	depends on ARCH_ESWIN || COMPILE_TEST
	help
	  This driver supports clock controller of ESWIN EIC7700 series SoC.
	  The driver require a 24MHz Oscillator to function generate clock.
	  It includes PLLs, common clock function and some vendor clock for
	  IPs of EIC7700 series SoC
